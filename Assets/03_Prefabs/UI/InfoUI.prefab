  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"\uC5B4\uC11C\uC624\uC138\uC694, \uD478\uB974\uACE0 \uB4DC\uB113\uC740
    \uC81C\uC8FC\uC758 \uBC14\uB2E4\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4.\r\n\uAC80\uD478\uB978
    \uD574\uC5ED\uACFC \uAE30\uC554\uAD34\uC11D\uC774 \uC5B4\uC6B0\uB7EC\uC9C4 \uC81C\uC8FC
    \uBC14\uB2E4\uB294 \uC0AC\uACC4\uC808 \uB0B4\uB0B4 \uB2E4\uC591\uD55C \uC5B4\uC885\uC774
    \uC11C\uC2DD\uD558\uB294 \uC0DD\uBA85\uC758 \uBCF4\uACE0\uC785\uB2C8\uB2E4.\r\n\uC794\uC794\uD55C
    \uD30C\uB3C4 \uC18C\uB9AC\uC640 \uC9ED\uC870\uB984\uD55C \uBC14\uB2E4 \uB0B4\uC74C\uC744
    \uB290\uB07C\uBA70, \uC81C\uC8FC\uC758 \uC790\uC5F0\uACFC \uD568\uAED8 \uB09A\uC2DC
    \uCCB4\uD5D8\uC744 \uC990\uACA8\uBCF4\uC138\uC694.\u201C\r\n\r\n\"\uC774\uACF3
    \uC81C\uC8FC \uBC14\uB2E4\uC5D0\uC11C\uB294 \uACC4\uC808\uB9C8\uB2E4 \uB2E4\uC591\uD55C
    \uC5B4\uC885\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uBD04\uC5D0\uB294
    \uACE0\uB4F1\uC5B4\uC640 \uC790\uB9AC\uB3D4, \uC5EC\uB984\uC5D0\uB294 \uBC29\uC5B4\uC640
    \uAD11\uC5B4, \uAC00\uC744\uC5D0\uB294 \uCC38\uB3D4\uACFC \uAC08\uCE58, \uACA8\uC6B8\uC5D0\uB294
    \uC81C\uC8FC \uD2B9\uC0B0 \uC5B4\uC885\uC778 \uD55C\uCE58\uAE4C\uC9C0!\r\n\uC9C1\uC811
    \uB09A\uC2DC\uB97C \uD1B5\uD574 \uC7A1\uC544\uBCF4\uBA70, \uC81C\uC8FC\uC758
    \uD574\uC591 \uC0DD\uD0DC\uACC4\uB97C \uBAB8\uC18C \uCCB4\uD5D8\uD574\uBCF4\uC138\uC694.\u201C"
